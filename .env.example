# =============================================================================
# Molly Dashboard — environment configuration
#
# Copy this file to `.env.local` for local development. Variables prefixed
# with NEXT_PUBLIC_ are exposed to the browser; everything else stays
# server-side only.
# =============================================================================

# -----------------------------------------------------------------------------
# ROS bridge
# -----------------------------------------------------------------------------

# rosbridge_suite WebSocket endpoint. Must include ws:// or wss://.
# Use the robot's LAN IP in production:
#   NEXT_PUBLIC_ROSBRIDGE_URL=ws://192.168.1.120:9090
NEXT_PUBLIC_ROSBRIDGE_URL=ws://localhost:9090

# web_video_server HTTP base. Camera feeds will be requested at
# `${VIDEO_SERVER_URL}/stream?topic=...`.
NEXT_PUBLIC_VIDEO_SERVER_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

# When true, the dashboard renders mock OccupancyGrid / POIs / telemetry
# instead of waiting for live ROS data. Defaults to true in development,
# false in production.
NEXT_PUBLIC_USE_MOCKS=true

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------

# Postgres connection string. Server-side only — NOT prefixed with NEXT_PUBLIC.
DATABASE_URL=postgresql://user:password@localhost:5432/molly_dashboard
